# Confidential configuration files (MAC address, IP, SSH credentials,
# script path, passwords...): NEVER commit.
instance/config.py

# User accounts / invitations database (generated on first start): contains
# password hashes, never commit.
instance/app.db
instance/*.db-journal

# Python virtual environments
venv/
.venv/
env/

# Compiled Python files
__pycache__/
*.pyc

# Logs
*.log

# Environment files
.env
.env.*

# Misc OS / editors
.DS_Store
Thumbs.db
.vscode/
