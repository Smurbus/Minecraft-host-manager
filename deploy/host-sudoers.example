# -----------------------------------------------------------------------
# Install on the Ubuntu HOST PC (NOT on the Raspberry Pi).
# Copy this file to /etc/sudoers.d/mc-controller, then:
#   sudo chmod 440 /etc/sudoers.d/mc-controller
#   sudo visudo -c        # checks the syntax before trusting the file
#
# Replace "your_user" and the script path with your real values
# (the same ones as SSH_USER and START_SCRIPT_PATH in instance/config.py).
# Allow ONLY these two exact commands in NOPASSWD, not "ALL".
# -----------------------------------------------------------------------

your_user ALL=(ALL) NOPASSWD: /usr/bin/bash /path/to/your/start_script.sh
your_user ALL=(ALL) NOPASSWD: /usr/sbin/shutdown -h now
