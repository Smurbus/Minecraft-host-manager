[Unit]
Description=Contrôleur web du serveur Minecraft (Raspberry Pi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adaptez User et les chemins ci-dessous à votre installation réelle
# (utilisateur Linux + dossier où le dépôt a été cloné sur le Raspberry).
User=pi
WorkingDirectory=/home/pi/mc-controller
Environment=PATH=/home/pi/mc-controller/venv/bin
# Écoute uniquement en local : le reverse proxy (Caddy/Nginx) gère le TLS et l'exposition externe.
ExecStart=/home/pi/mc-controller/venv/bin/waitress-serve --listen=127.0.0.1:8000 wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
